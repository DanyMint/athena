HOST_PORT=80
DOMAIN_NAME=localhost_for_example
VITE_BACKEND_API_URL=http://$DOMAIN_NAME/api/

# Security
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,$DOMAIN_NAME

# CORS
ALLOWED_DOMAINS=http://localhost:$HOST_PORT,http://$DOMAIN_NAME:$HOST_PORT,https://$DOMAIN_NAME:$HOST_PORT,http://localhost:3000,http://localhost,http://127.0.0.1
CORS_ALLOW_ALL_ORIGINS=""
CORS_ALLOWED_ORIGINS=$ALLOWED_DOMAINS
CSRF_TRUSTED_ORIGINS=$ALLOWED_DOMAINS

# Database
POSTGRES_USER="athena"
POSTGRES_PASSWORD="pswd4athena"
POSTGRES_DB="athena_db"
POSTGRES_PORT=5432
POSTGRES_HOST="athena_ps_db"

# Session and Cookie security
SESSION_COOKIE_SECURE=""
CSRF_COOKIE_SECURE=""
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax

# Session settings
SESSION_COOKIE_AGE=86400
SESSION_SAVE_EVERY_REQUEST=True
SESSION_EXPIRE_AT_BROWSER_CLOSE=""

# Security settings
SECURE_HSTS_SECONDS=3600
SECURE_SSL_REDIRECT=""
SECURE_HSTS_PRELOAD=""
SECURE_HSTS_INCLUDE_SUBDOMAINS=""
